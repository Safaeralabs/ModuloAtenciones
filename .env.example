# Copia este archivo como .env y ajusta los valores antes de desplegar.

# Entorno: "production" hace que el backend sirva el frontend (dist) y aplique seguridad.
NODE_ENV=production

# Puerto del servidor.
PORT=4000

# Secreto para firmar los tokens de sesion (JWT).
# IMPORTANTE: cambialo por una cadena larga y aleatoria en produccion.
JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# Duracion de la sesion por inactividad (RNF Seguridad: 30 min). El token se
# renueva en cada peticion (ventana deslizante), asi que solo caduca tras este
# tiempo SIN actividad. Acepta formato de vercel/ms: 30m, 1h, etc.
JWT_TTL=30m

# Origen permitido para CORS. En produccion (mismo origen) puedes dejar *.
CORS_ORIGIN=*

# Credenciales del usuario administrador que se siembra en el PRIMER arranque.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# ─── Base de datos MySQL (BD de Mercadeo) ───
# Requisito fijo de la Plataforma de Mercadeo. Reemplaza el SQLite anterior.
DB_HOST=localhost
DB_PORT=3306
DB_USER=mercadeo
DB_PASSWORD=cambia-esta-clave
DB_NAME=mercadeo
# Solo la usa docker-compose para crear el usuario root de MySQL en el primer arranque.
DB_ROOT_PASSWORD=cambia-esta-clave-root

# Ruta del archivo SQLite ANTERIOR (solo para el script de migracion de datos,
# npm run migrate:sqlite). Por defecto: server/data/turnero.db
# SQLITE_PATH=./server/data/turnero.db

# ─── Webservice SISU (subsidios: consulta de afiliado + empresa por cedula) ───
# Proveedor: mock (datos simulados), rest (HTTP/JSON), soap (XML), off (deshabilitado).
WS_PROVIDER=mock
# URL del webservice REST de SISU. Usa {cedula} como marcador del documento.
# Ej: https://sisu.comfaguajira.co/api/afiliados/{cedula}
# WS_URL=
# Token/clave de autenticacion de SISU (si aplica).
# WS_API_KEY=
# Tiempo maximo de espera de la consulta, en milisegundos.
WS_TIMEOUT_MS=5000

# ─── Correo SMTP (alertas de cotizaciones por vencer, seccion 14) ───
# Si SMTP_HOST queda vacio, el envio de correo se deshabilita y solo quedan las
# notificaciones dentro de la plataforma. Llena estos datos cuando TI entregue
# el servidor SMTP de Comfaguajira.
# SMTP_HOST=smtp.comfaguajira.co
SMTP_PORT=587
# 'true' solo para TLS directo (puerto 465); para STARTTLS deja false.
SMTP_SECURE=false
# SMTP_USER=mercadeo@comfaguajira.co
# SMTP_PASSWORD=cambia-esta-clave
# Remitente que veran los asesores en el correo.
SMTP_FROM=Mercadeo Comfaguajira <no-reply@comfaguajira.co>

# ─── Respaldo automatico de la BD (RNF Backup, mysqldump diario 2am) ───
# Desactiva con false. La copia se guarda en BACKUP_DIR; en produccion apunta a
# otro disco o recurso de red DISTINTO al servidor principal.
BACKUP_ENABLED=true
# BACKUP_DIR=D:/backups/mercadeo
BACKUP_RETENTION_DAYS=14
# Ruta al binario mysqldump si no esta en el PATH (ej. instalacion noinstall).
# MYSQLDUMP_PATH=C:/mysql84/bin/mysqldump.exe
